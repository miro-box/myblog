ext !== undefined &amp;&amp; text !== null) n.textContent = text;&#xD;&#xA;        return n;&#xD;&#xA;    }&#xD;&#xA;    function panelOf(name) {&#xD;&#xA;        return panels.filter(function (p) { return p.dataset.bangumiPanel === name; })[0];&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    panels.forEach(function (p) {&#xD;&#xA;        var name = p.dataset.bangumiPanel;&#xD;&#xA;        [].slice.call(p.querySelectorAll(&#39;.bangumi-card&#39;)).forEach(function (c, i) { c.dataset.idx = i; });&#xD;&#xA;        state[name] = {&#xD;&#xA;            batch: parseInt(p.dataset.batch, 10) || 24,&#xD;&#xA;            limit: parseInt(p.dataset.batch, 10) || 24,&#xD;&#xA;            view: name === &#39;watched&#39; ? &#39;rate&#39; : &#39;orig&#39;&#xD;&#xA;        };&#xD;&#xA;    });&#xD;&#xA;&#xD;&#xA;    function sortCards(panel, view) {&#xD;&#xA;        var grid = panel.querySelector(&#39;.bangumi-grid&#39;);&#xD;&#xA;        var cards = [].slice.call(grid.children);&#xD;&#xA;        cards.sort(function (a, b) {&#xD;&#xA;            var A = a.dataset, B = b.dataset;&#xD;&#xA;            if (view === &#39;rate&#39;) return (B.rate - A.rate) || (A.idx - B.idx);&#xD;&#xA;            if (view === &#39;year&#39;) return ((B.year || 0) - (A.year || 0)) || (B.rate - A.rate) || (A.idx - B.idx);&#xD;&#xA;            return A.idx - B.idx;&#xD;&#xA;        });&#xD;&#xA;        cards.forEach(function (c) { grid.appendChild(c); });&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    function render(panel) {&#xD;&#xA;        var s = state[panel.dataset.bangumiPanel];&#xD;&#xA;        var q = (search.value || &#39;&#39;).trim().toLowerCase();&#xD;&#xA;        sortCards(panel, s.view);&#xD;&#xA;        var shown = 0, matched = 0;&#xD;&#xA;        [].slice.call(panel.querySelectorAll(&#39;.bangumi-card&#39;)).forEach(function (c) {&#xD;&#xA;            var ok = !q || (c.dataset.title || &#39;&#39;).toLowerCase().indexOf(q) &gt; -1;&#xD;&#xA;            if (!ok) { c.hidden = true; return; }&#xD;&#xA;            matched++;&#xD;&#xA;            if (shown &lt; s.limit) { c.hidden = false; shown++; } else { c.hidden = true; }&#xD;&#xA;        });&#xD;&#xA;        panel.querySelector(&#39;.bangumi-more&#39;).hidden = matched &lt;= shown;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    function activate(name) {&#xD;&#xA;        active = name;&#xD;&#xA;        tabs.forEach(function (t) { t.classList.toggle(&#39;is-active&#39;, t.dataset.bangumiTab === name); });&#xD;&#xA;        panels.forEach(function (p) { p.classList.toggle(&#39;is-active&#39;, p.dataset.bangumiPanel === name); });&#xD;&#xA;        render(panelOf(name));&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    tabs.forEach(function (t) {&#xD;&#xA;        t.addEventListener(&#39;click&#39;, function () { activate(t.dataset.bangumiTab); });&#xD;&#xA;    });&#xD;&#xA;&#xD;&#xA;    search.addEventListener(&#39;input&#39;, function () {&#xD;&#xA;        var p = panelOf(active);&#xD;&#xA;        if (!p) return;&#xD;&#xA;        state[active].limit = state[active].batch;&#xD;&#xA;        render(p);&#xD;&#xA;    });&#xD;&#xA;&#xD;&#xA;    panels.forEach(function (p) {&#xD;&#xA;        var name = p.dataset.bangumiPanel;&#xD;&#xA;        p.querySelector(&#39;.bangumi-more&#39;).addEventListener(&#39;click&#39;, function () {&#xD;&#xA;            state[name].limit += state[name].batch;&#xD;&#xA;            render(p);&#xD;&#xA;        });&#xD;&#xA;        [].slice.call(p.querySelectorAll(&#39;.bangumi-view&#39;)).forEach(function (b) {&#xD;&#xA;            b.addEventListener(&#39;click&#39;, function () {&#xD;&#xA;                state[name].view = b.dataset.bangumiView;&#xD;&#xA;                state[name].limit = state[name].batch;&#xD;&#xA;                [].slice.call(p.querySelectorAll(&#39;.bangumi-view&#39;)).forEach(function (x) {&#xD;&#xA;                    x.classList.toggle(&#39;is-active&#39;, x === b);&#xD;&#xA;                });&#xD;&#xA;                render(p);&#xD;&#xA;            });&#xD;&#xA;        });&#xD;&#xA;    });&#xD;&#xA;&#xD;&#xA;     &#xD;&#xA;    function row(label, value) {&#xD;&#xA;        var r = el(&#39;div&#39;, &#39;bangumi-modal-row&#39;);&#xD;&#xA;        r.appendChild(el(&#39;b&#39;, &#39;&#39;, label));&#xD;&#xA;        r.appendChild(el(&#39;span&#39;, &#39;&#39;, value));&#xD;&#xA;        return r;&#xD;&#xA;    }&#xD;&#xA;    function openModal(card) {&#xD;&#xA;        var d = card.dataset;&#xD;&#xA;        modalBody.textContent = &#39;&#39;;&#xD;&#xA;        var main = el(&#39;div&#39;, &#39;bangumi-modal-main&#39;);&#xD;&#xA;        var img = el(&#39;img&#39;);&#xD;&#xA;        img.src = d.cover; img.alt = d.title; img.referrerPolicy = &#39;no-referrer&#39;;&#xD;&#xA;        main.appendChild(img);&#xD;&#xA;        var info = el(&#39;div&#39;, &#39;bangumi-modal-info&#39;);&#xD;&#xA;        info.appendChild(el(&#39;div&#39;, &#39;bangumi-modal-title&#39;, d.title));&#xD;&#xA;        info.appendChild(row(&#39;我的评分&#39;, Number(d.rate) &gt; 0 ? d.rate : &#39;未评分&#39;));&#xD;&#xA;        info.appendChild(row(&#39;Bangumi 分数&#39;, Number(d.score) &gt; 0 ? d.score : &#39;暂无&#39;));&#xD;&#xA;        if (Number(d.rank) &gt; 0) info.appendChild(row(&#39;Bangumi 排名&#39;, &#39;#&#39; + d.rank));&#xD;&#xA;        if (d.progress) info.appendChild(row(&#39;观看进度&#39;, d.progress));&#xD;&#xA;        if (d.year) info.appendChild(row(&#39;年份&#39;, d.year));&#xD;&#xA;        if (d.comment) info.appendChild(el(&#39;div&#39;, &#39;bangumi-modal-comment&#39;, d.comment));&#xD;&#xA;        var link = el(&#39;a&#39;, &#39;bangumi-modal-link&#39;, &#39;在 Bangumi 查看 ↝&#39;);&#xD;&#xA;        link.href = &#39;https://bangumi.tv/subject/&#39; + d.id;&#xD;&#xA;        link.target = &#39;_blank&#39;; link.rel = &#39;noopener noreferrer&#39;;&#xD;&#xA;        info.appendChild(link);&#xD;&#xA;        main.appendChild(info);&#xD;&#xA;        modalBody.appendChild(main);&#xD;&#xA;        modal.hidden = false;&#xD;&#xA;    }&#xD;&#xA;    function closeModal() { modal.hidden = true; }&#xD;&#xA;&#xD;&#xA;    root.addEventListener(&#39;click&#39;, function (e) {&#xD;&#xA;        var card = e.target.closest(&#39;.bangumi-card&#39;);&#xD;&#xA;        if (!card || !root.contains(card)) return;&#xD;&#xA;        if (e.ctrlKey || e.metaKey) return;&#xD;&#xA;        e.preventDefault();&#xD;&#xA;        openModal(card);&#xD;&#xA;    });&#xD;&#xA;    root.querySelector(&#39;.bangumi-modal-close&#39;).addEventListener(&#39;click&#39;, closeModal);&#xD;&#xA;    root.querySelector(&#39;.bangumi-modal-backdrop&#39;).addEventListener(&#39;click&#39;, closeModal);&#xD;&#xA;    document.addEventListener(&#39;keydown&#39;, function (e) { if (e.key === &#39;Escape&#39;) closeModal(); });&#xD;&#xA;&#xD;&#xA;     &#xD;&#xA;    function showRandom(item) {&#xD;&#xA;        randomBox.textContent = &#39;&#39;;&#xD;&#xA;        var a = el(&#39;a&#39;, &#39;bangumi-random-card&#39;);&#xD;&#xA;        a.href = &#39;https://bangumi.tv/subject/&#39; + item.id;&#xD;&#xA;        a.target = &#39;_blank&#39;; a.rel = &#39;noopener noreferrer&#39;;&#xD;&#xA;        var img = el(&#39;img&#39;);&#xD;&#xA;        img.src = item.cover; img.alt = item.title; img.referrerPolicy = &#39;no-referrer&#39;;&#xD;&#xA;        a.appendChild(img);&#xD;&#xA;        var info = el(&#39;div&#39;, &#39;bangumi-info&#39;);&#xD;&#xA;        info.appendChild(el(&#39;div&#39;, &#39;bangumi-name&#39;, item.title));&#xD;&#xA;        var meta = el(&#39;div&#39;, &#39;bangumi-meta&#39;);&#xD;&#xA;        if (item.year) meta.appendChild(el(&#39;span&#39;, &#39;&#39;, item.year));&#xD;&#xA;        if (Number(item.score) &gt; 0) meta.appendChild(el(&#39;span&#39;, &#39;&#39;, &#39;Bangumi &#39; + item.score));&#xD;&#xA;        info.appendChild(meta);&#xD;&#xA;        a.appendChild(info);&#xD;&#xA;        randomBox.appendChild(a);&#xD;&#xA;        randomBox.hidden = false;&#xD;&#xA;    }&#xD;&#xA;    function localPick() {&#xD;&#xA;        var pool = [].slice.call(root.querySelectorAll(&#39;.bangumi-card&#39;)).map(function (c) {&#xD;&#xA;            return { id: c.dataset.id, title: c.dataset.title, cover: c.dataset.cover, score: c.dataset.score, year: c.dataset.year };&#xD;&#xA;        });&#xD;&#xA;        return pool[Math.floor(Math.random() * pool.length)];&#xD;&#xA;    }&#xD;&#xA;    function remotePick() {&#xD;&#xA;        var ctrl = new AbortController();&#xD;&#xA;        var timer = setTimeout(function () { ctrl.abort(); }, 5000);&#xD;&#xA;        var offset = Math.floor(Math.random() * 2000);&#xD;&#xA;        var url = &#39;https://api.bgm.tv/v0/subjects?type=2&amp;sort=rank&amp;limit=1&amp;offset=&#39; + offset;&#xD;&#xA;        return fetch(url, { signal: ctrl.signal, headers: { Accept: &#39;application/json&#39; } })&#xD;&#xA;            .then(function (r) { clearTimeout(timer); if (!r.ok) throw new Error(&#39;bad status&#39;); return r.json(); })&#xD;&#xA;            .then(function (j) {&#xD;&#xA;                var s = j.data &amp;&amp; j.data[0];&#xD;&#xA;                if (!s) throw new Error(&#39;empty&#39;);&#xD;&#xA;                var im = s.images || {};&#xD;&#xA;                return {&#xD;&#xA;                    id: s.id,&#xD;&#xA;                    title: s.name_cn || s.name,&#xD;&#xA;                    cover: im.common || im.medium || im.large || &#39;&#39;,&#xD;&#xA;                    score: (s.rating &amp;&amp; s.rating.score) || s.score || &#39;&#39;,&#xD;&#xA;                    year: (s.date || &#39;&#39;).slice(0, 4)&#xD;&#xA;                };&#xD;&#xA;            });&#xD;&#xA;    }&#xD;&#xA;    randomBtn.addEventListener(&#39;click&#39;, function () {&#xD;&#xA;        randomBox.textContent = &#39;&#39;;&#xD;&#xA;        randomBox.appendChild(el(&#39;div&#39;, &#39;bangumi-random-tip&#39;, &#39;正在抽取…&#39;));&#xD;&#xA;        randomBox.hidden = false;&#xD;&#xA;        remotePick().then(showRandom).catch(function () {&#xD;&#xA;            var item = localPick();&#xD;&#xA;            if (item) showRandom(item);&#xD;&#xA;        });&#xD;&#xA;    });&#xD;&#xA;&#xD;&#xA;     &#xD;&#xA;    root.classList.add(&#39;is-ready&#39;);&#xD;&#xA;    if (tabs.length) activate(tabs[0].dataset.bangumiTab);&#xD;&#xA;})();&#xD;&#xA;&lt;/script&gt;&#xA;</description>
